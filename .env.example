# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: absolute origin used in invite/reset email links (defaults to the
# request origin, e.g. http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Vercel AI Gateway key for the in-app assistant (https://vercel.com/ai-gateway).
# Without it the /assistant chat endpoint responds 503.
AI_GATEWAY_API_KEY=

# Optional sender for invite/reset emails. Defaults to Resend's shared test
# domain (onboarding@resend.dev), which only delivers to the Resend account
# owner's email. Set to a verified-domain address for production, e.g.
# "Kano Health Finance Tracker <no-reply@yourdomain.gov.ng>"
EMAIL_FROM=
